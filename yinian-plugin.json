{
  "manifestVersion": 1,
  "id": "yinian-couchdb",
  "name": "自建 CouchDB 同步",
  "version": "0.3.0",
  "author": "vangelis",
  "description": "多端同步的传输后端：把一念加密后的字节搬到你自己的 CouchDB。只搬字节，看不懂内容。",
  "homepage": "https://github.com/VangelisHaha/yinian-plugin-couchdb",
  "minHostVersion": "0.12.0",
  "runtime": {
    "kind": "process",
    "node": ">=20",
    "entry": {
      "default": "dist/main.mjs"
    }
  },
  "permissions": {
    "net": [
      "*"
    ],
    "spawn": [],
    "fs": [],
    "api": []
  },
  "contributes": {
    "replica": {
      "id": "couchdb",
      "name": "CouchDB",
      "capabilities": {
        "watch": true,
        "delete": true,
        "maxObjectBytes": 4194304
      }
    },
    "settingsPanel": [
      "settings.plugin.json"
    ]
  },
  "authMode": [
    "basic"
  ]
}
